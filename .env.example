# Database Configuration
# When running API locally outside docker (with PostgreSQL mapped to localhost:5432):
DATABASE_URL=postgresql+asyncpg://careerpath:careerpath@localhost:5432/careerpath
# When running with docker compose, DATABASE_URL inside the api container is:
# DATABASE_URL=postgresql+asyncpg://careerpath:careerpath@db:5432/careerpath

# Database credentials (for PostgreSQL container)
POSTGRES_USER=careerpath
POSTGRES_PASSWORD=careerpath
POSTGRES_DB=careerpath

# OpenAI API Key (optional for basic local run, required for AI endpoints)
OPENAI_API_KEY=your-openai-api-key-here
